// Muse Code subscriptions use the same Model API wire contract as direct Meta API keys.

provider "muse-code" {
	default-model "muse-spark-1.3"
	dynamic-models-authoritative #true

	// Muse Code shares Meta Model API's model capabilities and equivalent token pricing.
	seed api="openai-responses" base-url="https://api.meta.ai/v1" bundle="always" {
		models-from "meta"
	}

	include-encrypted-reasoning #true
	supports-reasoning-effort #true
	clamp-output-to-model-max #true
	// api.meta.ai/v1 accepts only tool_choice "auto"; "none", "required" and named
	// choices are rejected with 400 (verified 2026-09-10), so omit the field.
	supports-tool-choice #false
	// Results can be stored so a dropped stream is recovered: verified 2026-09-29
	// against api.meta.ai/v1, a stored run keeps generating after the client
	// socket dies and `GET /responses/{id}` returns it once finished (~60s for
	// a high-effort turn), while `store: false` runs 404 forever. Storage is
	// opt-in (privacy: stored runs retain prompts/outputs on Meta's side): omp
	// setting providers.muse-code.storeResponses or PI_MUSE_STORE_RESPONSES=1.
	store-responses #true
	// Subscription tier bills per request; the compact edit prompt cuts the
	// recurring tool-schema bytes. Verified 2026-09-05 against api.meta.ai/v1:
	// `custom` tools are rejected with 400 "`custom` tools are not supported
	// on this endpoint", so apply-patch must stay a function tool here.
	edit-prompt-variant "compact"
	on-api "openai-responses" {
		// Spark 1.3 Contributor warmed siblings hit 10/10 vs 0/10 with per-child keys (2026-10-12).
		// Meta documents shared-prefix prompt_cache_key routing; keep the opt-in on these exact Muse Code IDs.
		models "muse-spark-1.3" "muse-spark-1.3-contributor" "muse-wonder-1.0" "muse-wonder-1.0-contributor" "muse-wonder-full-1.0" "muse-wonder-full-1.0-contributor" {
			task-sibling-prompt-cache #true
		}
	}
	// Same capability-less `/v1/models` as Meta: unknown ids are opt-in.
	class "unknown" {
		thinking-unverified #true
		thinking-efforts "minimal" "low" "medium" "high" "xhigh"
		thinking-mode "effort"
	}
}
